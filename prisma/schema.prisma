generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id               String            @id @default(cuid())
  name             String
  gstin            String            @unique
  address          String
  phone            String
  email            String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activityLogs     ActivityLog[]
  companies        Company[]
  customers        Customer[]
  importedInvoices ImportedInvoice[]
  inventoryBatches    InventoryBatch[]
  invoiceSettings     InvoiceSettings?
  billingSettings     BillingSettings?
  expiryAlertSettings ExpiryAlertSettings?
  medicines           Medicine[]
  medicineReturns  MedicineReturn[]
  purchases        Purchase[]
  rackLocations    RackLocation[]
  returns          Return[]
  sales            Sale[]
  shopSettings     ShopSettings?
  stockLedgers     StockLedger[]
  suppliers        Supplier[]
  users            User[]

  @@index([name])
}

model ShopSettings {
  id           String   @id @default(cuid())
  shopId       String   @unique
  shopName     String   @default("")
  addressLine1 String   @default("")
  addressLine2 String?
  phone        String   @default("")
  email            String   @default("")
  gstin            String   @default("")
  commanderActions Json?
  createdAt        DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model InvoiceSettings {
  id                String   @id @default(cuid())
  shopId            String   @unique
  shopName          String
  addressLine1      String
  addressLine2      String?
  phone             String
  email             String
  gstin             String
  invoicePrefix     String   @default("INV-")
  nextInvoiceNumber Int      @default(1)
  watermarkText     String   @default("")
  watermarkEnabled  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model BillingSettings {
  id                     String   @id @default(cuid())
  shopId                 String   @unique
  enableRetail           Boolean  @default(true)
  enableWholesale        Boolean  @default(true)
  allowDiscounts         Boolean  @default(true)
  enableBarcode          Boolean  @default(true)
  autoPrintInvoice       Boolean  @default(false)
  gstMode                String   @default("inclusive") // "inclusive" | "exclusive"
  defaultDiscountPercent Decimal  @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  shop                   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model ExpiryAlertSettings {
  id                  String   @id @default(cuid())
  shopId              String   @unique
  shop                Shop     @relation(fields: [shopId], references: [id])
  enableWhatsApp      Boolean  @default(true)
  enableEmail         Boolean  @default(true)
  whatsappNumber      String   @default("")
  emailAddress        String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


model User {
  id              String           @id @default(cuid())
  shopId          String
  name            String
  email           String
  phone           String?
  avatarUrl       String?
  passwordHash    String
  role            String           @default("CASHIER")
  pin             String?
  isActive        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activityLogs    ActivityLog[]
  loginHistory    LoginHistory[]
  medicineReturns MedicineReturn[]
  returns         Return[]
  sales           Sale[]
  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@index([shopId])
  @@index([email])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  status    String   @default("success")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Supplier {
  id            String     @id @default(cuid())
  shopId        String
  name          String
  contactPerson String?
  phone         String
  email         String
  address       String
  city          String?
  state         String?
  gstin         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
}

model Company {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@index([shopId, phone])
  @@index([shopId])
}

model Medicine {
  id                String           @id @default(cuid())
  shopId            String
  name              String
  company           String
  category          String
  barcode           String?
  hsn               String
  packing           String?
  unit              String           @default("strip")
  lowStockThreshold Int              @default(0)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  mrp               Decimal?         @default(0)
  tradePrice        Decimal?         @default(0)
  gstPercent        Int              @default(0)
  batches           InventoryBatch[]
  shop              Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  medicineReturns   MedicineReturn[]
  purchaseItems     PurchaseItem[]
  returns           Return[]
  saleItems         SaleItem[]
  stockLedgers      StockLedger[]

  @@unique([shopId, barcode])
  @@index([shopId, name])
  @@index([shopId, company])
  @@index([shopId, barcode])
}

model InventoryBatch {
  id            String         @id @default(cuid())
  shopId        String
  medicineId    String
  batchNumber   String
  expiryDate    DateTime
  stockQty      Int            @default(0)
  mrp           Decimal
  purchaseRate  Decimal?
  sellingRate   Decimal
  rackLocation  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medicine      Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseItems PurchaseItem[]
  returns       Return[]
  saleItems     SaleItem[]
  stockLedgers  StockLedger[]

  @@unique([shopId, medicineId, batchNumber])
  @@index([shopId, medicineId, expiryDate])
  @@index([shopId, medicineId])
  @@index([expiryDate])
  @@index([medicineId])
}

model Purchase {
  id            String         @id @default(cuid())
  shopId        String
  supplierId    String
  invoiceNumber String
  invoiceDate   DateTime
  gstType       String         @default("GST")
  paymentType   String         @default("CASH")
  status        String         @default("PAID")
  subtotal      Decimal        @default(0)
  discountTotal Decimal        @default(0)
  gstTotal      Decimal        @default(0)
  totalAmount   Decimal
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseItems PurchaseItem[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId, supplierId])
  @@index([shopId])
}

model PurchaseItem {
  id           String         @id @default(cuid())
  purchaseId   String
  medicineId   String
  batchId      String
  quantity     Int
  freeQty      Int            @default(0)
  scheme       String?
  purchaseRate Decimal?
  mrp          Decimal
  discount     Decimal        @default(0)
  gst          Decimal        @default(0)
  expiryDate   DateTime
  batch        InventoryBatch @relation(fields: [batchId], references: [id])
  medicine     Medicine       @relation(fields: [medicineId], references: [id])
  purchase     Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([batchId])
}

model Sale {
  id              String     @id @default(cuid())
  shopId          String
  customerId      String?
  saleType        String     @default("RETAIL")
  invoiceNumber   String
  subtotal        Decimal
  discountTotal   Decimal    @default(0)
  gstTotal        Decimal
  grandTotal      Decimal
  paymentMode     String
  creditDue       Decimal?   @default(0)
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdByUser   User       @relation(fields: [createdByUserId], references: [id])
  customer        Customer?  @relation(fields: [customerId], references: [id])
  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  saleItems       SaleItem[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId, createdAt])
  @@index([shopId])
  @@index([customerId])
}

model SaleItem {
  id         String         @id @default(cuid())
  saleId     String
  medicineId String
  batchId    String
  quantity   Int
  mrp        Decimal
  rate       Decimal
  discount   Decimal        @default(0)
  gst        Decimal
  amount     Decimal
  batch      InventoryBatch @relation(fields: [batchId], references: [id])
  medicine   Medicine       @relation(fields: [medicineId], references: [id])
  sale       Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([batchId])
}

model StockLedger {
  id          String         @id @default(cuid())
  shopId      String
  medicineId  String
  batchId     String
  type        String
  qty         Int
  referenceId String
  createdAt   DateTime       @default(now())
  batch       InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  medicine    Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([medicineId])
  @@index([batchId])
}

model Return {
  id              String         @id @default(cuid())
  shopId          String
  type            String
  referenceId     String
  medicineId      String
  batchId         String
  quantity        Int
  reason          String
  createdByUserId String
  createdAt       DateTime       @default(now())
  batch           InventoryBatch @relation(fields: [batchId], references: [id])
  createdByUser   User           @relation(fields: [createdByUserId], references: [id])
  medicine        Medicine       @relation(fields: [medicineId], references: [id])
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([type])
}

model ActivityLog {
  id        String   @id @default(cuid())
  shopId    String
  userId    String?
  action    String
  meta      String?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
  @@index([userId])
}

model ImportJob {
  id          String   @id @default(cuid())
  status      String   @default("processing")
  currentPage Int      @default(0)
  totalPages  Int      @default(0)
  message     String?
  error       String?
  medicines   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shopId      String   @default("")

  @@index([createdAt])
}

model PdfImportJob {
  id             String   @id @default(cuid())
  shopId         String
  userId         String
  fileName       String
  pdfText        String
  status         String   @default("pending")
  medicinesCount Int      @default(0)
  medicines      String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shopId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MedicineReturn {
  id              String   @id @default(cuid())
  shopId          String
  medicineId      String
  companyId       String?
  batchNumber     String?
  expiryDate      DateTime
  mrp             Decimal
  quantity        Int
  reason          String
  notes           String?
  status          String   @default("PROCESSED")
  type            String   @default("CUSTOMER")
  createdByUserId String
  createdAt       DateTime @default(now())
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  medicine        Medicine @relation(fields: [medicineId], references: [id])
  shop            Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([medicineId])
  @@index([type])
  @@index([createdAt])
}

model RackLocation {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id])

  @@unique([shopId, name])
  @@index([shopId])
}

model ApiUsageCounter {
  id         String   @id @default(cuid())
  date       String   @unique
  gemini     Int      @default(0)
  groq       Int      @default(0)
  openrouter Int      @default(0)
  updatedAt  DateTime @updatedAt
  cloudflare Int      @default(0)
  mistral    Int      @default(0)
  cerebras   Int      @default(0)
}

model ImportedInvoice {
  id               String   @id @default(cuid())
  shopId           String
  invoiceNumber    String
  supplierName     String
  invoiceDate      String?
  medicineCount    Int      @default(0)
  totalStock       Int      @default(0)
  importedByUserId String?
  createdAt        DateTime @default(now())
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, invoiceNumber, supplierName])
  @@index([shopId])
}

model StockAdjustment {
  id          String   @id @default(cuid())
  shopId      String
  medicineId  String
  batchId     String
  userId      String
  type        String   // "ADD" or "REMOVE"
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([batchId])
  @@index([medicineId])
}
