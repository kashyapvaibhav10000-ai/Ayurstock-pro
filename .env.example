# Database
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="15m"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000"
OPENROUTER_API_KEY=""

# App
NEXT_PUBLIC_APP_NAME="AyurStock Pro"

# AI provider keys (Settings > AI)
# 32-byte master key for encrypting stored provider keys (64 hex chars).
# Generate: openssl rand -hex 32. Never commit the real value.
AI_ENCRYPTION_KEY=
# Comma-separated emails of ADMIN users allowed to manage AI keys.
SUPER_ADMIN_EMAILS=
