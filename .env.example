# Database
DATABASE_URL="file:./prisma/dev.db"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="15m"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000"
OPENROUTER_API_KEY=""

# App
NEXT_PUBLIC_APP_NAME="AyurStock Pro"

# AI provider keys (Settings > AI)
# 32-byte master key for encrypting stored provider keys (64 hex chars).
# Generate: openssl rand -hex 32. Never commit the real value.
AI_ENCRYPTION_KEY=
# Super-admins (manage AI keys): ADMIN users whose email is in
# SUPER_ADMIN_EMAILS or whose username is in SUPER_ADMIN_USERNAMES.
# Comma-separated, case-insensitive. Usernames are globally unique; emails
# are only unique per shop, so prefer SUPER_ADMIN_USERNAMES.
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_USERNAMES=
