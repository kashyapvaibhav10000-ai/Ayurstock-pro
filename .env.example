# Database
DATABASE_URL="file:./prisma/dev.db"

# Auth
# At least 32 characters; the app refuses to start in production otherwise.
# Generate: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRATION="15m"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000"
OPENROUTER_API_KEY=""

# App
NEXT_PUBLIC_APP_NAME="AyurStock Pro"

# AI provider keys (Settings > AI)
# 32-byte master key for encrypting stored provider keys (64 hex chars).
# Generate: openssl rand -hex 32. Never commit the real value.
AI_ENCRYPTION_KEY=
# Super-admins (manage AI keys): user ids (User.id) of ADMIN users,
# comma-separated. Ids never change, so editing an email or username cannot
# grant or lose the role. SUPER_ADMIN_EMAILS / SUPER_ADMIN_USERNAMES are no
# longer read.
SUPER_ADMIN_USER_IDS=

# Key for hashing POS PINs (HMAC). At least 32 characters; required in
# production. Keep it stable: changing it invalidates every PIN.
# Generate: openssl rand -hex 32
PIN_HASH_KEY=

# Set to "cloudflare" when the app is reached only through Cloudflare Tunnel
# and listens on 127.0.0.1. Rate limits then key on CF-Connecting-IP.
# Leave empty otherwise (X-Forwarded-For is never trusted).
TRUST_PROXY=

# AI provider calls each shop may make per UTC day (default 200).
AI_DAILY_CALLS_PER_SHOP=
